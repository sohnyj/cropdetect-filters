+
+/* Must match the block size of the launch in vf_cropdetect_cuda.c. */
+#define BLOCK_X 32
+#define BLOCK_Y 32
+
+/*
+ * Sums the samples of the luma plane per row and per column. line_sum holds
+ * the height row sums followed by the width column sums.
+ *
+ * Each block stores its tile of samples in shared memory. Then BLOCK_X
+ * threads sum the columns of the tile and BLOCK_Y threads its rows, and add
+ * the partial sums to line_sum.
+ */
+template<typename T>
+__device__ static inline void sum_lines(const unsigned char *src, int pitch,
+                                        int width, int height, int shift,
+                                        unsigned int *line_sum)
+{
+    /* The padding column puts the samples a thread sums along a row
+     * on distinct shared memory banks. */
+    __shared__ unsigned int tile[BLOCK_Y][BLOCK_X + 1];
+
+    const int x = blockIdx.x * BLOCK_X + threadIdx.x;
+    const int y = blockIdx.y * BLOCK_Y + threadIdx.y;
+    const int index = threadIdx.y * BLOCK_X + threadIdx.x;
+
+    tile[threadIdx.y][threadIdx.x] = x < width && y < height ?
+        ((const T *)(src + y * pitch))[x] >> shift : 0;
+
+    __syncthreads();
+
+    if (index < BLOCK_X) {
+        const int column = blockIdx.x * BLOCK_X + index;
+        unsigned int sum = 0;
+
+        if (column >= width)
+            return;
+
+        for (int row = 0; row < BLOCK_Y; row++)
+            sum += tile[row][index];
+        atomicAdd(&line_sum[height + column], sum);
+    } else if (index < BLOCK_X + BLOCK_Y) {
+        const int row = index - BLOCK_X;
+        const int line = blockIdx.y * BLOCK_Y + row;
+        unsigned int sum = 0;
+
+        if (line >= height)
+            return;
+
+        for (int column = 0; column < BLOCK_X; column++)
+            sum += tile[row][column];
+        atomicAdd(&line_sum[line], sum);
+    }
+}
+
+extern "C" {
+
+__global__ void cropdetect_uchar(const unsigned char *src, int pitch,
+                                 int width, int height, int shift,
+                                 unsigned int *line_sum)
+{
+    sum_lines<unsigned char>(src, pitch, width, height, shift, line_sum);
+}
+
+__global__ void cropdetect_ushort(const unsigned char *src, int pitch,
+                                  int width, int height, int shift,
+                                  unsigned int *line_sum)
+{
+    sum_lines<unsigned short>(src, pitch, width, height, shift, line_sum);
+}
