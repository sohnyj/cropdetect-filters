+/**
+ * @file
+ * border detection filter
+ * CUDA port of the black mode of vf_cropdetect.c.
+ */
+
+#include "libavutil/cuda_check.h"
+#include "libavutil/hwcontext.h"
+#include "libavutil/hwcontext_cuda_internal.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "cuda/load_helper.h"
+#include "filters.h"
+
+#define CHECK_CU(x) FF_CUDA_CHECK_DL(ctx, s->hwctx->internal->cuda_dl, x)
+#define DIV_UP(a, b) ( ((a) + (b) - 1) / (b) )
+
+/* Must match the block size of the kernels in vf_cropdetect_cuda.cu. */
+#define BLOCK_X 32
+#define BLOCK_Y 32
+
+static const enum AVPixelFormat supported_formats[] = {
+    AV_PIX_FMT_YUV420P,
+    AV_PIX_FMT_YUV422P,
+    AV_PIX_FMT_YUV444P,
+    AV_PIX_FMT_YUV420P10,
+    AV_PIX_FMT_YUV422P10,
+    AV_PIX_FMT_YUV444P10,
+    AV_PIX_FMT_YUV444P10MSB,
+    AV_PIX_FMT_YUV420P12,
+    AV_PIX_FMT_YUV422P12,
+    AV_PIX_FMT_YUV444P12,
+    AV_PIX_FMT_YUV444P12MSB,
+    AV_PIX_FMT_YUV420P16,
+    AV_PIX_FMT_YUV422P16,
+    AV_PIX_FMT_YUV444P16,
+    AV_PIX_FMT_YUVA420P,
+    AV_PIX_FMT_YUVA422P,
+    AV_PIX_FMT_YUVA444P,
+    AV_PIX_FMT_YUVA420P10,
+    AV_PIX_FMT_YUVA422P10,
+    AV_PIX_FMT_YUVA444P10,
+    AV_PIX_FMT_YUVA422P12,
+    AV_PIX_FMT_YUVA444P12,
+    AV_PIX_FMT_YUVA420P16,
+    AV_PIX_FMT_YUVA422P16,
+    AV_PIX_FMT_YUVA444P16,
+    AV_PIX_FMT_NV12,
+    AV_PIX_FMT_NV16,
+    AV_PIX_FMT_NV24,
+    AV_PIX_FMT_P010,
+    AV_PIX_FMT_P012,
+    AV_PIX_FMT_P016,
+    AV_PIX_FMT_P210,
+    AV_PIX_FMT_P212,
+    AV_PIX_FMT_P216,
+    AV_PIX_FMT_P410,
+    AV_PIX_FMT_P412,
+    AV_PIX_FMT_P416,
+};
+
+typedef struct CropDetectCUDAContext {
+    const AVClass *class;
+
+    AVBufferRef *device_ref;
+    AVCUDADeviceContext *hwctx;
+    CUstream cu_stream;
+    CUmodule cu_module;
+    CUfunction cu_func_uchar;
+    CUfunction cu_func_ushort;
+    CUfunction cu_func;           ///< kernel for the sample size of the input
+    CUdeviceptr line_sum;         ///< row sums followed by column sums
+    uint32_t *line_sum_host;      ///< page-locked copy of line_sum
+    int shift;
+
+    int x1, y1, x2, y2;
+    float limit;
+    float limit_upscaled;
+    int round;
+    int skip;
+    int reset_count;
+    int frame_nb;
+    int max_outliers;
+    int bitdepth;
+} CropDetectCUDAContext;
+
+static av_cold int cropdetect_cuda_init(AVFilterContext *ctx)
+{
+    CropDetectCUDAContext *s = ctx->priv;
+
+    s->frame_nb = -1 * s->skip;
+
+    av_log(ctx, AV_LOG_VERBOSE, "limit:%f round:%d skip:%d reset_count:%d\n",
+           s->limit, s->round, s->skip, s->reset_count);
+
+    return 0;
+}
+
+static av_cold void cropdetect_cuda_uninit(AVFilterContext *ctx)
+{
+    CropDetectCUDAContext *s = ctx->priv;
+
+    if (s->hwctx) {
+        CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+        CUcontext dummy;
+
+        CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+        if (s->line_sum)
+            CHECK_CU(cu->cuMemFree(s->line_sum));
+        if (s->line_sum_host)
+            CHECK_CU(cu->cuMemFreeHost(s->line_sum_host));
+        if (s->cu_module)
+            CHECK_CU(cu->cuModuleUnload(s->cu_module));
+        CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+    }
+
+    s->hwctx = NULL;
+    av_buffer_unref(&s->device_ref);
+}
+
+static av_cold int cropdetect_cuda_load_functions(AVFilterContext *ctx,
+                                                  size_t sum_size)
+{
+    CropDetectCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    CUcontext dummy;
+    void *line_sum_host;
+    int ret;
+
+    extern const unsigned char ff_vf_cropdetect_cuda_ptx_data[];
+    extern const unsigned int ff_vf_cropdetect_cuda_ptx_len;
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+    if (ret < 0)
+        return ret;
+
+    ret = ff_cuda_load_module(ctx, s->hwctx, &s->cu_module,
+                              ff_vf_cropdetect_cuda_ptx_data,
+                              ff_vf_cropdetect_cuda_ptx_len);
+    if (ret < 0)
+        goto end;
+
+    ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_uchar, s->cu_module,
+                                           "cropdetect_uchar"));
+    if (ret < 0)
+        goto end;
+
+    ret = CHECK_CU(cu->cuModuleGetFunction(&s->cu_func_ushort, s->cu_module,
+                                           "cropdetect_ushort"));
+    if (ret < 0)
+        goto end;
+
+    ret = CHECK_CU(cu->cuMemAlloc(&s->line_sum, sum_size));
+    if (ret < 0)
+        goto end;
+
+    ret = CHECK_CU(cu->cuMemHostAlloc(&line_sum_host, sum_size, 0));
+    if (ret < 0)
+        goto end;
+    s->line_sum_host = line_sum_host;
+
+end:
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+
+    return ret;
+}
+
+static int cropdetect_cuda_config_props(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    CropDetectCUDAContext *s = ctx->priv;
+    AVFilterLink *inlink = ctx->inputs[0];
+    FilterLink *inl = ff_filter_link(inlink);
+    FilterLink *outl = ff_filter_link(outlink);
+    AVHWFramesContext *in_frames_ctx;
+    const AVPixFmtDescriptor *desc;
+    int format_supported = 0;
+    int ret;
+
+    if (!inl->hw_frames_ctx) {
+        av_log(ctx, AV_LOG_ERROR, "No hw context provided on input\n");
+        return AVERROR(EINVAL);
+    }
+    in_frames_ctx = (AVHWFramesContext *)inl->hw_frames_ctx->data;
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(supported_formats); i++) {
+        if (in_frames_ctx->sw_format == supported_formats[i]) {
+            format_supported = 1;
+            break;
+        }
+    }
+    if (!format_supported) {
+        av_log(ctx, AV_LOG_ERROR, "Unsupported input format: %s\n",
+               av_get_pix_fmt_name(in_frames_ctx->sw_format));
+        return AVERROR(ENOSYS);
+    }
+
+    s->device_ref = av_buffer_ref(in_frames_ctx->device_ref);
+    if (!s->device_ref)
+        return AVERROR(ENOMEM);
+    s->hwctx     = ((AVHWDeviceContext *)s->device_ref->data)->hwctx;
+    s->cu_stream = s->hwctx->stream;
+
+    ret = cropdetect_cuda_load_functions(ctx, (inlink->w + inlink->h) *
+                                              sizeof(*s->line_sum_host));
+    if (ret < 0)
+        return ret;
+
+    desc        = av_pix_fmt_desc_get(in_frames_ctx->sw_format);
+    s->cu_func  = desc->comp[0].step == 1 ? s->cu_func_uchar : s->cu_func_ushort;
+    s->shift    = desc->comp[0].shift;
+    s->bitdepth = desc->comp[0].depth;
+
+    if (s->limit < 1.0)
+        s->limit_upscaled = s->limit * ((1 << s->bitdepth) - 1);
+    else
+        s->limit_upscaled = s->limit;
+
+    s->x1 = inlink->w - 1;
+    s->y1 = inlink->h - 1;
+    s->x2 = 0;
+    s->y2 = 0;
+
+    outl->hw_frames_ctx = av_buffer_ref(inl->hw_frames_ctx);
+    if (!outl->hw_frames_ctx)
+        return AVERROR(ENOMEM);
+
+    return 0;
+}
+
+static int sum_lines(AVFilterContext *ctx, const AVFrame *in)
+{
+    CropDetectCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    const AVFilterLink *inlink = ctx->inputs[0];
+    CUdeviceptr src = (CUdeviceptr)in->data[0];
+    int pitch  = in->linesize[0];
+    int width  = inlink->w;
+    int height = inlink->h;
+    int shift  = s->shift;
+    void *args[] = { &src, &pitch, &width, &height, &shift, &s->line_sum };
+    int ret;
+
+    ret = CHECK_CU(cu->cuMemsetD32Async(s->line_sum, 0, width + height,
+                                        s->cu_stream));
+    if (ret < 0)
+        return ret;
+
+    ret = CHECK_CU(cu->cuLaunchKernel(s->cu_func,
+                                      DIV_UP(width, BLOCK_X), DIV_UP(height, BLOCK_Y), 1,
+                                      BLOCK_X, BLOCK_Y, 1,
+                                      0, s->cu_stream, args, NULL));
+    if (ret < 0)
+        return ret;
+
+    ret = CHECK_CU(cu->cuMemcpyDtoHAsync(s->line_sum_host, s->line_sum,
+                                         (width + height) * sizeof(*s->line_sum_host),
+                                         s->cu_stream));
+    if (ret < 0)
+        return ret;
+
+    return CHECK_CU(cu->cuStreamSynchronize(s->cu_stream));
+}
+
+#define SET_META(key, value) \
+    av_dict_set_int(metadata, key, value, 0)
+
+static void evaluate(AVFilterLink *inlink, AVFrame *frame,
+                     const uint32_t *line_sum)
+{
+    AVFilterContext *ctx = inlink->dst;
+    CropDetectCUDAContext *s = ctx->priv;
+    int w, h, x, y, shrink_by;
+    AVDictionary **metadata = &frame->metadata;
+    int outliers, last_y;
+    int limit_upscaled = lrint(s->limit_upscaled);
+    char limit_str[22];
+
+    const int inw = inlink->w;
+    const int inh = inlink->h;
+    const uint32_t *row_sum = line_sum;
+    const uint32_t *col_sum = line_sum + inh;
+
+    /* Reset the crop area every reset_count frames, if reset_count is > 0 */
+    if (s->reset_count > 0 && s->frame_nb > s->reset_count) {
+        s->x1 = inw - 1;
+        s->y1 = inh - 1;
+        s->x2 = 0;
+        s->y2 = 0;
+        s->frame_nb = 1;
+    }
+
+#define FIND(DST, FROM, NOEND, INC, SUM, LEN) \
+    outliers = 0;\
+    for (last_y = y = FROM; NOEND; y = y INC) {\
+        if ((int)(SUM[y] / LEN) > limit_upscaled) {\
+            if (++outliers > s->max_outliers) { \
+                DST = last_y;\
+                break;\
+            }\
+        } else\
+            last_y = y INC;\
+    }
+
+    FIND(s->y1,       0,               y < s->y1, +1, row_sum, inw);
+    FIND(s->y2, inh - 1, y > FFMAX(s->y2, s->y1), -1, row_sum, inw);
+    FIND(s->x1,       0,               y < s->x1, +1, col_sum, inh);
+    FIND(s->x2, inw - 1, y > FFMAX(s->x2, s->x1), -1, col_sum, inh);
+
+    /* round x and y (up), important for yuv colorspaces
+     * make sure they stay rounded! */
+    x = (s->x1+1) & ~1;
+    y = (s->y1+1) & ~1;
+
+    w = s->x2 - x + 1;
+    h = s->y2 - y + 1;
+
+    /* w and h must be divisible by 2 as well because of yuv
+     * colorspace problems. */
+    if (s->round <= 1)
+        s->round = 16;
+    if (s->round % 2)
+        s->round *= 2;
+
+    shrink_by = w % s->round;
+    w -= shrink_by;
+    x += (shrink_by/2 + 1) & ~1;
+
+    shrink_by = h % s->round;
+    h -= shrink_by;
+    y += (shrink_by/2 + 1) & ~1;
+
+    SET_META("lavfi.cropdetect.x1", s->x1);
+    SET_META("lavfi.cropdetect.x2", s->x2);
+    SET_META("lavfi.cropdetect.y1", s->y1);
+    SET_META("lavfi.cropdetect.y2", s->y2);
+    SET_META("lavfi.cropdetect.w",  w);
+    SET_META("lavfi.cropdetect.h",  h);
+    SET_META("lavfi.cropdetect.x",  x);
+    SET_META("lavfi.cropdetect.y",  y);
+
+    snprintf(limit_str, sizeof(limit_str), "%f", s->limit);
+    av_dict_set(metadata, "lavfi.cropdetect.limit", limit_str, 0);
+
+    av_log(ctx, AV_LOG_INFO,
+           "x1:%d x2:%d y1:%d y2:%d w:%d h:%d x:%d y:%d pts:%"PRId64" t:%f limit:%f crop=%d:%d:%d:%d\n",
+           s->x1, s->x2, s->y1, s->y2, w, h, x, y, frame->pts,
+           frame->pts == AV_NOPTS_VALUE ? -1 : frame->pts * av_q2d(inlink->time_base),
+           s->limit, w, h, x, y);
+}
+
+static int cropdetect_cuda_filter_frame(AVFilterLink *inlink, AVFrame *in)
+{
+    AVFilterContext *ctx = inlink->dst;
+    CropDetectCUDAContext *s = ctx->priv;
+    CudaFunctions *cu = s->hwctx->internal->cuda_dl;
+    AVFilterLink *outlink = ctx->outputs[0];
+    CUcontext dummy;
+    int ret;
+
+    /* ignore first s->skip frames */
+    if (++s->frame_nb <= 0)
+        return ff_filter_frame(outlink, in);
+
+    ret = CHECK_CU(cu->cuCtxPushCurrent(s->hwctx->cuda_ctx));
+    if (ret < 0) {
+        av_frame_free(&in);
+        return ret;
+    }
+
+    ret = sum_lines(ctx, in);
+
+    CHECK_CU(cu->cuCtxPopCurrent(&dummy));
+
+    if (ret < 0) {
+        av_frame_free(&in);
+        return ret;
+    }
+
+    evaluate(inlink, in, s->line_sum_host);
+
+    return ff_filter_frame(outlink, in);
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    CropDetectCUDAContext *s = ctx->priv;
+    float old_limit = s->limit;
+    int ret;
+
+    if ((ret = ff_filter_process_command(ctx, cmd, args, res, res_len, flags)) < 0)
+        return ret;
+
+    if (old_limit != s->limit) {
+        if (s->limit < 1.0)
+            s->limit_upscaled = s->limit * ((1 << s->bitdepth) - 1);
+        else
+            s->limit_upscaled = s->limit;
+        s->frame_nb = s->reset_count;
+    }
+
+    return 0;
+}
+
+#define OFFSET(x) offsetof(CropDetectCUDAContext, x)
+#define FLAGS (AV_OPT_FLAG_FILTERING_PARAM | AV_OPT_FLAG_VIDEO_PARAM)
+#define TFLAGS (FLAGS | AV_OPT_FLAG_RUNTIME_PARAM)
+static const AVOption cropdetect_cuda_options[] = {
+    { "limit", "Threshold below which the pixel is considered black", OFFSET(limit),       AV_OPT_TYPE_FLOAT, { .dbl = 24.0/255 }, 0, 65535, TFLAGS },
+    { "round", "Value by which the width/height should be divisible", OFFSET(round),       AV_OPT_TYPE_INT, { .i64 = 16 }, 0, INT_MAX, FLAGS },
